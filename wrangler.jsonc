{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pwacorsica-soundscape",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-11",
  "workers_dev": true,
  "keep_vars": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api", "/api/*", "/uploads", "/uploads/*"]
  },
  "vars": {
    "SUPABASE_URL": "https://alkjdnvjsaofuepynwxw.supabase.co",
    "VAPID_SUBJECT": "https://pwacorsica-soundscape.ounesshimi.workers.dev/"
  },
  "env": {
    "v2": {
      "name": "pwacorsica-soundscape",
      "vars": {
        "SUPABASE_URL": "https://alkjdnvjsaofuepynwxw.supabase.co",
        "VAPID_SUBJECT": "https://pwacorsica-soundscape.ounesshimi.workers.dev/"
      }
    }
  }
}
